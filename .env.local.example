# OfferHelper 本地开发环境变量模板
# 复制此文件为 .env.local 并填入对应值
# 参考详细说明：docs/deployment.md

# Supabase（从 Supabase Dashboard → Project Settings 获取）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI 服务（本地用 Hyperspace，线上用硅基流动）
# 无 Hyperspace 时改为：https://api.siliconflow.cn/v1
ANTHROPIC_API_KEY=your-hyperspace-or-siliconflow-key
ANTHROPIC_BASE_URL=http://localhost:6655/anthropic/

# 加密密钥（必须与 Vercel 中的值完全一致，勿重新生成）
ENCRYPTION_KEY=your-32-byte-hex-key

# 邮件服务
RESEND_API_KEY=re_your-key

# 本地跳过使用限额（线上不要设置）
SKIP_USAGE_LIMIT=1
