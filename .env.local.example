# OfferHelper 环境变量配置清单（换电脑 / 部署参考）
#
# 使用方法：
#   1. 在项目根目录复制一份为 .env.local：cp .env.example .env.local
#   2. 把下面每个变量的值填进 .env.local（真实值不要提交到 git）
#   3. npm install && npm run dev
#
# 注意：.env.local 已被 .gitignore 忽略，真实密钥永远不进仓库。

# ── Supabase（数据库 + 认证）────────────────────────────────
# Supabase 控制台 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon public key（可暴露给前端）
SUPABASE_SERVICE_ROLE_KEY=              # service_role key（仅服务端用，机密！）

# ── AI 平台 ───────────────────────────────────────────────
# 本地开发：走 Anthropic SDK（Hyperspace 代理），ANTHROPIC_BASE_URL 指向 localhost
# 线上部署：走硅基流动（OpenAI 兼容），ANTHROPIC_API_KEY 填硅基流动的 key
ANTHROPIC_API_KEY=                      # 本地 = Anthropic key；线上 = 硅基流动 key
ANTHROPIC_BASE_URL=http://localhost:6655/anthropic/   # 本地用此值；线上不设或留空

# ── 加密 ──────────────────────────────────────────────────
# 用于 AES-256-GCM 加密用户的 AI Key，必须是 32 字节的密钥
# 换电脑时必须用同一个值，否则解不开已存的用户 Key
ENCRYPTION_KEY=

# ── 邮件（Resend，用于发送验证/通知邮件）────────────────────
RESEND_API_KEY=

# ── 百度 OCR（图片简历识别）────────────────────────────────
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ── 站点配置 ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000            # 本地此值；线上填 https://offerhelper.cloud

# ── 开发便利 ──────────────────────────────────────────────
# 设为 1 跳过限流（仅本地开发用，线上不要设）
SKIP_USAGE_LIMIT=1
